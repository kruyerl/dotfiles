# Ignore node modules installed for the pi config and its extensions
configs/pi/node_modules/
configs/pi/**/node_modules/

# Installed pi packages (reinstalled per-machine via 'pi install' / scripts/pi.sh --install-packages)
configs/pi/npm/
configs/pi/git/

# Ignore package lock files that may be created when installing deps for configs/pi
configs/pi/**/package-lock.json
configs/pi/**/npm-debug.log

# Other transient files created by npm installs
configs/pi/**/.package-lock.json
configs/pi/**/package-lock.json

# Local Pi state and secrets should never be committed
configs/pi/auth.json
configs/pi/models-store.json
configs/pi/settings.json
configs/pi/trust.json
configs/pi/sessions/
configs/pi/bin/
configs/pi/.env
configs/pi/.env.local
configs/pi/pi-debug.log
